{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080",

  "ConnectionStrings": {
    "//": "SQLite (Windows/dev) ou PostgreSQL: Host=db;Database=platform;Username=app;Password=app",
    "Default": "Data Source=./data/platform.db"
  },

  "Security": {
    "//JwtKey": "NÃO coloque a chave de produção aqui. Use variável de ambiente Security__JwtKey (min. 32 chars).",
    "JwtKey": "",
    "JwtIssuer": "SecurityPlatform",
    "JwtAudience": "SecurityPlatform",
    "TokenMinutes": 60,
    "PasswordMinLength": 10,
    "RequireStrongPassword": true,
    "PasswordExpiryDays": 0,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "BootstrapAdminPassword": "",
    "KeyRingPath": "./data/keys",
    "EnableSwagger": false,
    "AllowedClientOrigins": [],
    "LicenseSigningKey": "",
    "RequireSignedLicense": false,
    "Https": {
      "Enabled": false,
      "Port": 8443,
      "CertificatePath": "./auto.crt",
      "KeyPath": "./auto.key",
      "CertificatePassword": "",
      "AlsoListenHttp": true,
      "HttpPort": 8080
    },
    "Ldap": {
      "Enabled": false,
      "Host": "",
      "Port": 389,
      "UseSsl": false,
      "TimeoutSeconds": 8,
      "Domain": "",
      "UserPrincipalSuffix": "",
      "BindDnTemplate": "",
      "AutoProvision": true,
      "DefaultGroupName": "Operadores",
      "FallbackOnLocalFailure": true,
      "SyncGroups": true,
      "SearchBase": "",
      "UserSearchFilter": "(sAMAccountName={user})",
      "GroupMap": {}
    },
    "Oidc": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:8080/api/auth/oidc/callback",
      "Scopes": "openid profile email",
      "UsernameClaim": "preferred_username",
      "AutoProvision": true,
      "DefaultGroupName": "Operadores"
    },
    "Saml": {
      "Enabled": false,
      "EntityId": "SecurityPlatform",
      "IdpSsoUrl": "",
      "IdpEntityId": "",
      "AutoProvision": true,
      "DefaultGroupName": "Operadores",
      "AcsPath": "/api/auth/saml/acs"
    }
  },

  "Vms": {
    "MediaMtxApi": "http://localhost:9997",
    "MediaPublicHost": "http://localhost",
    "HlsPort": 8888,
    "WebRtcPort": 8889,
    "StoragePath": "./data/recordings",
    "FfmpegPath": "ffmpeg",
    "SegmentSeconds": 600,
    "RecorderEnabled": true,
    "RecordAudio": true,
    "SilentRecordingMinutes": 15,
    "ShardIndex": 0,
    "ShardCount": 1,
    "NodeId": "",
    "//HaEnabled": "true em multi-gravador + mesmo DB + Security:KeyRingPath compartilhado",
    "HaEnabled": false,
    "LeaseSeconds": 30,
    "TranscodeLive": false,
    "RecordBrowserCompatible": true,
    "RecordFromMediaGateway": true,
    "SingleCameraRtspPull": true,
    "AllowDirectCameraRecord": false,
    "MediaGatewayReadyTimeoutSeconds": 25,
    "EdgePullGapMinutes": 5,
    "PreEventSeconds": 15,
    "GapAlertMinutes": 5,
    "ThumbnailIntervalMinutes": 10,
    "ClusterId": "",
    "StorageVolumes": [],
    "//EventBus": "vazio = in-memory | redis://localhost:6379 | host:6379,password=…",
    "EventBus": "",
    "Mqtt": {
      "Enabled": false,
      "Host": "127.0.0.1",
      "Port": 1883,
      "ClientId": "",
      "Username": "",
      "Password": "",
      "Topics": [ "platform/iot/#" ],
      "TenantId": 1
    }
  }
}
